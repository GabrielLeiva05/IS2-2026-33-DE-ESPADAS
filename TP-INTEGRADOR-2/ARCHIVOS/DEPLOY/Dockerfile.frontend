# Etapa 1: compilacion de React con Vite
FROM node:22-alpine AS build

ARG APP
ARG VITE_API_URL

WORKDIR /app

# El contexto de construccion es movil/
# Copiamos el codigo compartido y la aplicacion seleccionada.
COPY comun/ ./comun/
COPY ${APP}/ ./app/

WORKDIR /app/app

RUN npm ci

# Vite incorpora esta variable en los archivos estaticos.
RUN VITE_API_URL="${VITE_API_URL}" npm run build

# Etapa 2: servidor estatico Nginx
FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf \
    && printf '%s\n' \
    'server {' \
    '    listen 80;' \
    '    server_name _;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' \
    > /etc/nginx/conf.d/default.conf

COPY --from=build /app/app/dist/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]