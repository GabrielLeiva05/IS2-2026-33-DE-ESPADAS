# Copiar como ".env" en el servidor (misma carpeta que docker-compose.yml). No subirlo a GitHub.
DOMINIO=midominio.com.ar
DB_ROOT_PASSWORD=cambiar-por-una-clave-larga
# openssl rand -base64 48
JWT_SECRET=
JEFE_INICIAL_CORREO=jefe@midominio.com.ar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ===== Pagos con Mercado Pago (Checkout API - QR) =====
MP_ACCESS_TOKEN=
MP_USER_ID=
MP_EXTERNAL_POS_ID=DULCEMAYOR-POS
# URL publica del webhook: https://<DOMINIO>/api/pagos/mercadopago/webhook
MP_NOTIFICATION_URL=https://midominio.com.ar/api/pagos/mercadopago/webhook
MP_BASE_URL=https://api.mercadopago.com
ALIAS_TRANSFERENCIA=dulcemayor.mp
TITULAR_TRANSFERENCIA=Dulce Mayor S.A.

# ===== Correo (SMTP) =====
CORREO_HABILITADO=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
CORREO_REMITENTE=no-responder@midominio.com.ar
CORREO_NOMBRE_REMITENTE=Dulce Mayor
