# Copiar como ".env" (misma carpeta que pom.xml) y completar. El archivo .env NO se sube al repositorio.
# Formato: CLAVE=valor (sin comillas ni espacios alrededor del "=").

# Base de datos
DB_URL=jdbc:mysql://localhost:3306/dulcemayor?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=update

# JWT: al menos 32 caracteres aleatorios. Generar uno propio, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=
# Duración del token (8 h) y máximo de una sesión renovada desde el ingreso (24 h), en milisegundos
JWT_EXPIRATION_MS=28800000
JWT_SESION_MAXIMA_MS=86400000

# Jefe administrativo inicial (clave temporal "dulcemayor")
JEFE_INICIAL_CORREO=jefe@dulcemayor.com.ar

# OAuth2: se activa con el perfil de Spring. Definir el perfil acá (por ejemplo oauth-google u
# oauth-google,oauth-facebook) y dejar vacío para desactivarlo. También se puede pasar como variable del sistema/IDE.
SPRING_PROFILES_ACTIVE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH2_REDIRECT_CLIENTE=http://localhost:8082/ingresar/oauth2

# Mapas (Ola 2). Nominatim (búsqueda de direcciones) y OSRM (recorrido por calles) son servicios externos de
# OpenStreetMap. Los servidores públicos tienen políticas de uso (1 consulta por segundo en Nominatim, OSRM demo
# sin garantía): para producción conviene una instancia propia o un proveedor contratado.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM también da la matriz de tiempos (/table) con la que se optimiza el orden de las paradas.
OSRM_URL=https://router.project-osrm.org
# Nominatim exige identificar la aplicación con un contacto real: completar con el correo del equipo.
MAPAS_USER_AGENT=DulceMayor/1.0 (trabajo practico integrador; contacto: completar-correo)

# Facturación (Ola 3): alícuota de IVA discriminada en las facturas
FACTURACION_ALICUOTA_IVA=0.21

# Datos de demostracion para probar los reportes (true por defecto; poner false para no cargarlos)
DATOS_DEMO_HABILITADO=true
# Cantidad de pedidos de demostracion a generar la primera vez
DATOS_DEMO_PEDIDOS=120

# ===================== Pagos con Mercado Pago (Checkout API - QR) =====================
# Credenciales de la aplicacion de Mercado Pago (panel de desarrolladores > Credenciales de produccion o de prueba).
# Sin MP_ACCESS_TOKEN no se puede cobrar con QR (transferencia y efectivo siguen funcionando).
MP_ACCESS_TOKEN=
MP_USER_ID=
# Punto de venta (caja) dado de alta en Mercado Pago. Debe ser el external_id de la caja: solo alfanumerico
MP_EXTERNAL_POS_ID=CAJA01
# URL publica del webhook. En desarrollo, exponer el backend con ngrok y pegar aqui la URL /api/pagos/mercadopago/webhook
MP_NOTIFICATION_URL=http://localhost:8080/api/pagos/mercadopago/webhook
MP_BASE_URL=https://api.mercadopago.com
# Alias y titular para el correo del pago por transferencia
ALIAS_TRANSFERENCIA=dulcemayor.mp
TITULAR_TRANSFERENCIA=Dulce Mayor S.A.

# ===================== Correo (SMTP) =====================
# Para probar rapido: Mailtrap (MAIL_HOST=sandbox.smtp.mailtrap.io, puerto 2525) o Gmail con clave de aplicacion.
CORREO_HABILITADO=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
CORREO_REMITENTE=no-responder@dulcemayor.com.ar
CORREO_NOMBRE_REMITENTE=Dulce Mayor
