	<style name="Estado" mode="Opaque" forecolor="#333333" backcolor="#EEEEEE" fontSize="8" isBold="true">
		<conditionalStyle>
			<conditionExpression><![CDATA["Entregado".equals($F{estadoEnvio})]]></conditionExpression>
			<style mode="Opaque" forecolor="#1B5E20" backcolor="#C8E6C9"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA["En reparto".equals($F{estadoEnvio})]]></conditionExpression>
			<style mode="Opaque" forecolor="#E65100" backcolor="#FFE0B2"/>
		</conditionalStyle>
		<conditionalStyle>
