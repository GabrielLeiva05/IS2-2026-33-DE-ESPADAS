=wrap;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="847" y="1219" width="1580" height="20" as="geometry"/></mxCell><mxCell id="c55" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="1298" as="sourcePoint"/><mxPoint x="2435" y="1298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="[else] Primera recepción de esa línea" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="811" y="1299" width="1618" height="16" as="geometry"/></mxCell><mxCell id="c57" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=38;height=18;fontSize=10;fontStyle=1;boundedLbl=1;backgroundOutline=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="796" y="1026" width="1648" height="680" as="geometry"/></mxCell><mxCell id="c58" value="Por cada línea (detalle) de la orden que no esté eliminada" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="838" y="1025" width="1598" height="20" as="geometry"/></mxCell><mxCell id="c75" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=38;height=18;fontSize=10;fontStyle=1;boundedLbl=1;backgroundOutline=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="2094" width="1198" height="156" as="geometry"/></mxCell><mxCell id="c76" value="[5.1] Si no existe una factura asociada a la orden" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="88" y="2093" width="1148" height="20" as="geometry"/></mxCell><mxCell id="c87" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=38;height=18;fontSize=10;fontStyle=1;boundedLbl=1;backgroundOutline=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="2486" width="1348" height="156" as="geometry"/></mxCell><mxCell i