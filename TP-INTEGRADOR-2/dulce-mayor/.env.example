# =====================================================================
# Dulce Mayor - configuracion de Docker Compose
# Copiar como ".env" en esta misma carpeta (lo lee "docker compose").
# Este archivo si se versiona; el ".env" real no.
# =====================================================================

# Puerto del host donde se publica PostgreSQL.
# Si ya hay un PostgreSQL instalado como servicio de Windows, ese ocupa el
# 5432: usar 5433 y apuntar DB_URL de backend/.env al mismo puerto.
POSTGRES_PORT=5432
POSTGRES_DB=dulcemayor
POSTGRES_USER=dulcemayor
POSTGRES_PASSWORD=dulce-mayor_dev
