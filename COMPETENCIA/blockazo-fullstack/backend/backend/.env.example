# Copiar este archivo como ".env" (en la misma carpeta que pom.xml) y completar los valores.
# El archivo .env esta en .gitignore: NO se sube al repositorio.
# Formato: CLAVE=valor  (sin comillas, sin espacios alrededor del "=" y sin espacios al final de la linea).
# Las variables de entorno reales del sistema tienen prioridad sobre este archivo.

DB_USERNAME=root
DB_PASSWORD=2003
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_DE_AL_MENOS_32_CARACTERES

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth0 (solo se usan si se activa el perfil auth0: SPRING_PROFILES_ACTIVE=auth0,
# esa variable se define en el sistema / IDE, no en este archivo)
# AUTH0_DOMAIN es solo el dominio, sin https:// ni "/" final.
AUTH0_DOMAIN=mi-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
