# =====================================================================
# Dulce Mayor - configuracion del backend (API)
# Copiar este archivo como "backend/.env" y completar. NO se sube al repo.
# Formato: CLAVE=valor (sin comillas ni espacios alrededor del "=")
# Todo lo que necesita la aplicacion se define aca: no hace falta configurar
# variables de entorno del sistema operativo.
# =====================================================================

# ---------------------------- Base de datos ---------------------------
DB_URL=jdbc:postgresql://localhost:5432/dulcemayor
DB_USERNAME=dulcemayor
DB_PASSWORD=dulcemayor_dev
JPA_DDL_AUTO=update
# Para MySQL, cambiar la URL y las credenciales:
# DB_URL=jdbc:mysql://localhost:3306/dulcemayor

# ---------------------------- Seguridad -------------------------------
# Clave HS256 de al menos 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-esta-clave-por-una-aleatoria-de-48-caracteres
JWT_EXPIRATION_MS=28800000

# Jefe administrativo inicial (clave temporal "dulcemayor", se cambia al ingresar)
JEFE_INICIAL_CORREO=jefe@dulcemayor.com.ar
JEFE_INICIAL_NOMBRE=Jefe
JEFE_INICIAL_APELLIDO=Administrativo
JEFE_INICIAL_DNI=20000000

# ---------------------------- Servidor ---------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8082

# ------------------- OAuth2 / OpenID Connect (clientes) ---------------
# Permite que un cliente ingrese con su cuenta de Google o Facebook.
# Poner APP_OAUTH2_HABILITADO=true y completar las credenciales del proveedor.
# URI de redireccion a registrar en el proveedor:
#   http://localhost:8080/login/oauth2/code/google
#   http://localhost:8080/login/oauth2/code/facebook
# En el sitio institucional tambien hay que activar los botones (ver institucional-web/.env.example).
APP_OAUTH2_HABILITADO=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH2_REDIRECT_CLIENTE=http://localhost:8082/ingresar/oauth2

# ---------------------------- Pagos ------------------------------------
# Transferencia y Mercado Pago vencen a las 24 h; efectivo sostiene la reserva 7 dias.
PAGOS_TRANSFERENCIA_VIGENCIA_HORAS=24
PAGOS_EFECTIVO_VIGENCIA_HORAS=168
PAGOS_EXPIRACION_HABILITADA=true
PAGOS_EXPIRACION_INTERVALO_MS=60000
PAGOS_EXPIRACION_RETRASO_INICIAL_MS=60000
# Mercado Pago (Checkout Pro). Sin MERCADOPAGO_ACCESS_TOKEN la API responde
# "no configurado" en lugar de simular una acreditacion.
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICACION_URL=
MERCADOPAGO_RUTA_PREFERENCIAS=/preferences
MERCADOPAGO_TIMEOUT_MS=8000

# ---------------------------- Correo -----------------------------------
# Sin MAIL_HOST el sistema no envia correos reales: registra cada envio en la
# tabla envios_correo y en el log (modo simulado). Con SMTP configurado envia de verdad.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_REMITENTE=no-reply@dulcemayor.test
MAIL_HABILITADO=true
NEWSLETTER_DIA=5
NEWSLETTER_URL_SITIO=http://localhost:8082

# --------------------- Cotizacion BCRA (informativa) -------------------
# APP_COTIZACION_URL=https://api.bcra.gob.ar/estadisticas/v2.0/datosvariable/5

# ------------------------ Datos de demostracion ------------------------
# true carga 12 comercios, 12 productos, pedidos en varios estados, una hoja de
# ruta y el plan de visitas. Las cuentas creadas usan la clave temporal
# "dulcemayor", que se debe cambiar en el primer ingreso.
DATOS_DEMO_HABILITADO=true