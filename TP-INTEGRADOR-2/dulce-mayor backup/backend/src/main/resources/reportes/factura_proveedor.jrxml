<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.20.6.final using JasperReports Library version 6.20.6 -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="factura_proveedor" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="31721750-8ce7-4b3f-8afd-410b7c38e9e3">
	<!-- Factura de PROVEEDOR: misma base que factura_cliente.jrxml (pedido de la Ola 3), con los datos del proveedor. Los datos salen de la base por la consulta
	     de abajo; la conexión la entrega el backend (DataSource de Spring): acá no hay credenciales. -->
	<style name="Base" isDefault="true" fontName="SansSerif" fontSize="10"/>
	<style name="Zebra" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#FDF2F9"/>
		</conditionalStyle>
	</style>
	<!-- Única entrada: el id de la factura persistida. La alícuota solo se usa para la leyenda del IVA. -->
	<parameter name="ID_FACTURA" class="java.lang.String"/>
	<parameter name="ALICUOTA_IVA" class="java.lang.Double">
		<defaultValueExpression><![CDATA[0.21]]></defaultValueExpression>
	</parameter>
	<!-- Forma de pago: la definirá el módulo de Pagos (FormaDePago). Mientras tanto se informa "A definir". -->
	<parameter name="MEDIO_PAGO" class="java.lang.String">
		<defaultValueExpression><![CDATA["A definir"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT f.numero_factura, f.fecha_factura, f.total, f.estado,
       prov.razon_social, prov.cuit,
       dir.calle, dir.numeracion, loc.nombre AS localidad,
       pr.nombre AS producto, pr.presentacion, pr.unidades_por_presentacion,
       d.cantidad, d.precio_unitario, d.subtotal AS subtotal_item,
       (SELECT SUM(d2.subtotal) FROM detalles_factura d2 WHERE d2.factura_id = f.id) AS subtotal_factura
FROM facturas f
JOIN facturas_proveedores fp ON fp.id = f.id
JOIN proveedores prov ON prov.id = fp.proveedor_id
JOIN direcciones dir ON dir.id = prov.direccion_id
JOIN localidades loc ON loc.id = dir.localidad_id
JOIN detalles_factura d ON d.factura_id = f.id
JOIN productos pr ON pr.id = d.producto_id
WHERE f.id = $P{ID_FACTURA}
ORDER BY pr.nombre, d.id]]>
	</queryString>
	<field name="numero_factura" class="java.lang.Long"/>
	<field name="fecha_factura" class="java.sql.Timestamp"/>
	<field name="total" class="java.lang.Double"/>
	<field name="estado" class="java.lang.String"/>
	<field name="razon_social" class="java.lang.String"/>
	<field name="cuit" class="java.lang.String"/>
	<field name="calle" class="java.lang.String"/>
	<field name="numeracion" class="java.lang.String"/>
	<field name="localidad" class="java.lang.String"/>
	<field name="producto" class="java.lang.String"/>
	<field name="presentacion" class="java.lang.String"/>
	<field name="unidades_por_presentacion" class="java.lang.Integer"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="precio_unitario" class="java.lang.Double"/>
	<field name="subtotal_item" class="java.lang.Double"/>
	<field name="subtotal_factura" class="java.lang.Double"/>
	<!-- IVA discriminado = total - subtotal (las facturas de proveedor no tienen descuento), igual que Factura.getIva() -->
	<variable name="IVA" class="java.lang.Double" calculation="Nothing">
		<variableExpression><![CDATA[Math.round(($F{total} - $F{subtotal_factura}) * 100.0) / 100.0]]></variableExpression>
	</variable>
