	<!-- Una fila por pedido. El listado debe llegar ORDENADO por cliente y comercio (agrupa por clavePuntoVenta). -->
	<field name="clavePuntoVenta" class="java.lang.String"/>
	<field name="dniCliente" class="java.lang.String"/>
	<field name="nombreCliente" class="java.lang.String"/>
	<field name="emailCliente" class="java.lang.String"/>
	<field name="nombreComercio" class="java.lang.String"/>
	<field name="departamento" class="java.lang.String"/>
	<field name="domicilioComercio" class="java.lang.String"/>
	<field name="numeroPedido" class="java.lang.String"/>
	<field name="fechaCarga" class="java.util.Date"/>
	<field name="preventista" class="java.lang.String"/>
	<field name="estadoPedido" class="java.lang.String"/>
	<field name="estadoEnvio" class="java.lang.String"/>
	<field name="fechaFacturacion" class="java.util.Date"/>
	<field name="fechaEntrega" class="java.util.Date"/>
	<field name="nombreDistribuidor" class="java.lang.String"/>
	<field name="montoFacturado" class="java.lang.Double"/>
	<variable name="cantPedidosCliente" class="java.lang.Integer" resetType="Group" resetGroup="ComercioGroup" calculation="Count">
		<variableExpression><![CDATA[$F{numeroPedido}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="totalCliente" class="java.lang.Double" resetType="Group" resetGroup="ComercioGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{montoFacturado} == null ? 0.0 : $F{montoFacturado}]]></variableExpression>
		<initialValueExpression><![CDATA[0.0]]></initialValueExpression>
	</variable>
	<variable name="cantClientes" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$V{ComercioGroup_COUNT} == 1 ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="cantPedidosTotal" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{numeroPedido}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="cantEntregados" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Entregado".equals($F{estadoEnvio}) ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="cantPendientes" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[("Pendiente de asignación".equals($F{estadoEnvio}) || "En reparto".equals($F{estadoEnvio})) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="totalGeneral" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{montoFacturado} == null ? 0.0 : $F{montoFacturado}]]></variableExpression>
		<initialValueExpression><![CDATA[0.0]]></initialValueExpression>
	</variable>
