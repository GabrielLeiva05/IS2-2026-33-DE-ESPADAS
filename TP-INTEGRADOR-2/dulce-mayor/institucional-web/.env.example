# Copiar como ".env" (misma carpeta que pom.xml) y completar lo necesario. NO se sube al repositorio.
# Formato: CLAVE=valor (sin comillas ni espacios alrededor del "=").

# Puerto del sitio (la API usa 8080 y admin-web 8081)
SERVER_PORT=8082

# URLs de la API
#   API_BASE_URL   : la usa el servidor para llamar a la API
#   API_PUBLIC_URL : la usa el navegador para las imágenes y los botones de Google/Facebook
API_BASE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# Ingreso con redes sociales. Activar SOLO cuando la API arranque con el perfil oauth-google /
# oauth-facebook (configurable en backend/.env con SPRING_PROFILES_ACTIVE) y las credenciales estén cargadas.
OAUTH_GOOGLE_HABILITADO=false
OAUTH_FACEBOOK_HABILITADO=false

# Cookies de sesión (poner COOKIE_SECURE=true cuando el sitio se sirva por HTTPS)
COOKIE_SECURE=false
