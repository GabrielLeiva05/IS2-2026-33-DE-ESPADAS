# =====================================================================
# Dulce Mayor - institucional-web (sitio para clientes)
# Copiar como "institucional-web/.env" y ajustar. NO se sube al repositorio.
# =====================================================================
SERVER_PORT=8082
API_BASE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
SESSION_TIMEOUT=30m
THYMELEAF_CACHE=false
FORWARD_HEADERS_STRATEGY=none

# Botones de ingreso con Google/Facebook. Activar SOLO junto con
# APP_OAUTH2_HABILITADO=true y las credenciales en backend/.env.
OAUTH_GOOGLE_HABILITADO=false
OAUTH_FACEBOOK_HABILITADO=false